# =============================================================================
# AGENTE PESSOAL DE ORGANIZAÇÃO DE VIDA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI — único provedor de IA (GPT-4o, Whisper, Vision, Embeddings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Telegram Bot
# Obtenha via @BotFather no Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://SEU_DOMINIO/webhooks/telegram

# Seu Telegram ID numérico (único usuário autorizado)
# Descubra via @userinfobot
TELEGRAM_ALLOWED_USER_ID=

# -----------------------------------------------------------------------------
# WhatsApp — Evolution API (opcional, Fase 4)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=https://SEU_EVOLUTION_API_URL
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agente-vida

# -----------------------------------------------------------------------------
# Google APIs
# Configure em: https://console.cloud.google.com
# Escopos necessários: Calendar, Sheets, Drive, Gmail
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# Supabase
# Obtenha em: https://app.supabase.com → Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Redis — cache de sessão e contexto de conversa
# Local: redis://localhost:6379
# Nuvem: Redis Cloud, Upstash, etc.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Pluggy — Open Finance brasileiro (Fase 4)
# Registre-se em: https://pluggy.ai
# -----------------------------------------------------------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Todoist — tarefas e listas (Fase 3)
# Obtenha em: https://app.todoist.com/app/settings/integrations/developer
# -----------------------------------------------------------------------------
TODOIST_API_TOKEN=

# -----------------------------------------------------------------------------
# Notion — base de conhecimento (Fase 4)
# Crie uma integração em: https://www.notion.so/my-integrations
# -----------------------------------------------------------------------------
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=

# -----------------------------------------------------------------------------
# n8n — orquestrador de fluxos
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://SEU_N8N/webhook
N8N_API_KEY=

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Chave secreta para validar webhooks (gere com: openssl rand -hex 32)
WEBHOOK_SECRET=

# Sessão TTL no Redis em segundos (padrão: 30 minutos)
REDIS_SESSION_TTL=1800

# Nível de log: error | warn | info | debug
LOG_LEVEL=info
