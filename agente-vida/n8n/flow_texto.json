{
  "name": "Agente Vida — Mensagem de Texto (Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-telegram",
      "name": "Webhook Telegram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "telegram-msg"
    },
    {
      "parameters": {
        "jsCode": "// Extrai tipo da mensagem recebida\nconst body = $input.first().json.body;\nconst msg = body?.message;\nif (!msg) return [{ json: { tipo: 'ignorar' } }];\n\nif (msg.text) return [{ json: { tipo: 'texto', msg } }];\nif (msg.voice || msg.audio) return [{ json: { tipo: 'audio', msg } }];\nif (msg.photo) return [{ json: { tipo: 'foto', msg } }];\nreturn [{ json: { tipo: 'desconhecido', msg } }];"
      },
      "id": "detectar-tipo",
      "name": "Detectar Tipo de Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.tipo }}", "rightValue": "texto", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.tipo }}", "rightValue": "audio", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.tipo }}", "rightValue": "foto", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } }
          ]
        },
        "options": {}
      },
      "id": "switch-tipo",
      "name": "Switch por Tipo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      },
      "id": "resposta-ok",
      "name": "Resposta 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook Telegram": { "main": [[{ "node": "Detectar Tipo de Mensagem", "type": "main", "index": 0 }]] },
    "Detectar Tipo de Mensagem": { "main": [[{ "node": "Switch por Tipo", "type": "main", "index": 0 }]] },
    "Switch por Tipo": {
      "main": [
        [{ "node": "Resposta 200", "type": "main", "index": 0 }],
        [{ "node": "Resposta 200", "type": "main", "index": 0 }],
        [{ "node": "Resposta 200", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Sao_Paulo" },
  "tags": ["agente-vida", "telegram", "entrada"],
  "versionId": "1",
  "_comentario": "Fluxo de referência — na arquitetura atual o Express processa diretamente. Use este fluxo para orquestrar lógica adicional de negócio no n8n."
}
